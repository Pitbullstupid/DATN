// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum TutorStatus {
  PENDING
  INCOMPLETE
  REVIEWING
  APPROVED
  REJECTED
  SUSPENDED
}

enum TutoringStyle {
  ONE_ON_ONE
  GROUP
  BOTH
}

enum TimingShift {
  MORNING
  AFTERNOON
  EVENING
  FLEXIBLE
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CourseStatus {
  PENDING_PAYMENT // chờ student thanh toán
  UPCOMING // chưa bắt đầu
  ONGOING // đang diễn ra
  COMPLETED // đã kết thúc
  CANCELLED // đã huỷ
}

enum SessionStatus {
  SCHEDULED // chưa diễn ra
  ONGOING // đang diễn ra
  COMPLETED // đã xong
  CANCELLED // bị huỷ / nghỉ
  ABSENT // học sinh vắng
}

// Thanh toan
enum PaymentStatus {
  PENDING // chờ thanh toán
  PAID // đã thanh toán, đang giữ (escrow)
  RELEASED // đã giải phóng cho tutor rút
  REFUNDED // hoàn tiền
  FAILED // thất bại
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum NotificationType {
  // Admin
  TUTOR_PROFILE_SUBMITTED // admin: tutor submitted profile for review
  WITHDRAWAL_REQUESTED    // admin: tutor requested withdrawal
  WITHDRAWAL_COMPLETED    // admin/tutor: withdrawal completed
  COURSE_ACTIVATED        // admin/tutor: course activated after payment
  REVIEW_CREATED          // admin/tutor: new course review

  // Booking
  BOOKING_RECEIVED      // tutor nhận booking mới
  BOOKING_ACCEPTED      // student: booking được accept
  BOOKING_REJECTED      // student: booking bị reject
  BOOKING_CANCELLED     // tutor: booking bị student huỷ

  // Payment
  PAYMENT_REQUIRED      // student: cần thanh toán
  PAYMENT_SUCCESS       // student: thanh toán thành công
  PAYMENT_RECEIVED      // tutor: nhận được thanh toán

  // Course
  COURSE_STARTED        // student: lớp đã bắt đầu
  COURSE_COMPLETED      // cả 2: khóa học hoàn thành
  COURSE_CANCELLED      // cả 2: khóa học bị huỷ

  // Session
  SESSION_CONFIRMED     // cả 2: buổi học đã xác nhận xong
  SESSION_CONFIRM_WAIT  // chờ bên kia xác nhận buổi học

  // End course confirm
  END_COURSE_REQUESTED  // student: tutor yêu cầu kết thúc
  END_COURSE_WAITING    // tutor: đang chờ student xác nhận

  // Wallet
  PAYMENT_RELEASED      // tutor: tiền được giải phóng
}

// ================== USER ==================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  gender    String?
  avatar    String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutorProfile    TutorProfile?
  messages        Message[]
  reviews         Review[]         @relation("StudentReviews")
  bookingsSent    BookingRequest[] @relation("StudentBookings")
  enrolledCourses CourseClass[]    @relation("StudentCourses")
  payments        Payment[]
  studentPayments Payment[]        @relation("StudentPayments")
  notifications Notification[]

  @@map("users")
}

// ================== TUTOR PROFILE ==================

model TutorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio     String?
  phone   String?
  address String?
  country String?

  subjects        String[]
  preferredAreas  String[]
  daysPerWeek     Int?
  timingShift     TimingShift?
  pricePerHour    Float?
  tutoringStyle   TutoringStyle?
  experience      Int?
  tuitionDuration Int?
  languages       String[]

  qualification String?
  certificate   String?

  socialMedia TutorSocialMedia?
  educations  TutorEducation[]

  status    TutorStatus @default(PENDING)
  adminNote String?

  rating       Float @default(0)
  totalReviews Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules       TutorSchedule[]
  reviews         Review[]
  bookingRequests BookingRequest[]
  courses         CourseClass[]
  payments        Payment[]
  wallet          TutorWallet?

  @@map("tutor_profiles")
}

// ================== TUTOR EDUCATION ==================

model TutorEducation {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  universityName String
  fieldOfStudy   String
  passingYear    Int
  result         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tutor_educations")
}

// ================== TUTOR SOCIAL MEDIA ==================

model TutorSocialMedia {
  id             String       @id @default(uuid())
  tutorProfileId String       @unique
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  facebook  String?
  twitter   String?
  youtube   String?
  instagram String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tutor_social_media")
}

// ================== BOOKING REQUEST ==================

model BookingRequest {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)

  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  name    String
  email   String
  subject String
  message String

  // Thông tin khóa học student mong muốn
  startDate     DateTime? // ngày muốn bắt đầu
  totalSessions Int? // số buổi mong muốn
  preferredDays String[] // ["MON","WED","FRI"]
  preferredTime String? // "08:00"

  status    BookingStatus @default(PENDING)
  tutorNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courseClass CourseClass? // khi ACCEPTED → tạo CourseClass

  @@map("booking_requests")
}

// ================== COURSE CLASS ==================
// Đại diện cho 1 khóa học / lớp học giữa tutor và student

model CourseClass {
  id String @id @default(uuid())

  studentId String
  student   User   @relation("StudentCourses", fields: [studentId], references: [id])

  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])

  bookingRequestId String?         @unique
  bookingRequest   BookingRequest? @relation(fields: [bookingRequestId], references: [id])

  // Thông tin khóa học
  subject         String
  startDate       DateTime // ngày bắt đầu
  endDate         DateTime // ngày kết thúc (dự kiến)
  totalSessions   Int // tổng số buổi học
  sessionsDone    Int      @default(0) // đã học xong
  durationMin     Int      @default(60) // độ dài mỗi buổi (phút)
  pricePerSession Float? // giá mỗi buổi
  totalPrice      Float? // tổng học phí
  note            String?

  status CourseStatus @default(UPCOMING)

  tutorConfirmedEnd   Boolean @default(false)
  studentConfirmedEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Thời khóa biểu của khóa (VD: T2+T4 08:00-09:00)
  schedules CourseSchedule[]

  // Từng buổi học cụ thể
  sessions CourseSession[]

  // Đánh giá sau khi kết thúc
  review Review?

  // Tin nhắn trong lớp
  messages Message[]
  payment  Payment?

  @@map("course_classes")
}

// ================== COURSE SCHEDULE ==================
// Thời khóa biểu lặp lại của 1 khóa học
// VD: Thứ 2 và Thứ 4, 08:00 - 09:30

model CourseSchedule {
  id            String      @id @default(uuid())
  courseClassId String
  courseClass   CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=CN, 1=T2, 2=T3, ..., 6=T7
  startTime String // "08:00"
  endTime   String // "09:30"

  createdAt DateTime @default(now())

  @@map("course_schedules")
}

// ================== COURSE SESSION ==================
// Từng buổi học cụ thể trong khóa

model CourseSession {
  id            String      @id @default(uuid())
  courseClassId String
  courseClass   CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  sessionNumber Int // buổi thứ mấy (1, 2, 3...)
  scheduledAt   DateTime // ngày giờ buổi học
  durationMin   Int           @default(60)
  status        SessionStatus @default(SCHEDULED)
  note          String? // ghi chú riêng buổi này (VD: nghỉ lễ, dời lịch)

  tutorConfirmed   Boolean @default(false)
  studentConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("course_sessions")
}

// ================== REVIEW ==================
// Student đánh giá sau khi CourseClass COMPLETED

model Review {
  id             String       @id @default(uuid())
  courseClassId  String       @unique
  courseClass    CourseClass  @relation(fields: [courseClassId], references: [id])
  studentId      String
  student        User         @relation("StudentReviews", fields: [studentId], references: [id])
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])

  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
}

// ================== MESSAGE ==================

model Message {
  id            String      @id @default(uuid())
  courseClassId String
  courseClass   CourseClass @relation(fields: [courseClassId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])

  content   String
  createdAt DateTime @default(now())

  @@map("messages")
}

// ================== TUTOR SCHEDULE ==================
// Lịch rảnh chung của gia sư (dùng để hiển thị profile)

model TutorSchedule {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  dayOfWeek Int
  startTime String
  endTime   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tutor_schedules")
}

model Payment {
  id             String       @id @default(uuid())
  courseClassId  String       @unique
  courseClass    CourseClass  @relation(fields: [courseClassId], references: [id])
  studentId      String
  student        User         @relation("StudentPayments", fields: [studentId], references: [id])
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])

  amount   Float // tổng tiền
  currency String        @default("usd")
  status   PaymentStatus @default(PENDING)

  // Stripe fields
  stripeSessionId     String? @unique
  stripePaymentIntent String?
  stripeChargeId      String?

  paidAt     DateTime?
  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  withdrawal Withdrawal?
  user       User?       @relation(fields: [userId], references: [id])
  userId     String?

  @@map("payments")
}

model TutorWallet {
  id             String       @id @default(uuid())
  tutorProfileId String       @unique
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])

  balance     Float @default(0) // số dư có thể rút
  heldAmount  Float @default(0) // đang giữ (escrow)
  totalEarned Float @default(0) // tổng đã kiếm

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  withdrawals Withdrawal[]

  @@map("tutor_wallets")
}

model Withdrawal {
  id        String      @id @default(uuid())
  walletId  String
  wallet    TutorWallet @relation(fields: [walletId], references: [id])
  paymentId String?     @unique
  payment   Payment?    @relation(fields: [paymentId], references: [id])

  amount Float
  status WithdrawStatus @default(PENDING)

  // Stripe Payout
  stripePayoutId String?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@map("withdrawals")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)

  // Link đến entity liên quan
  courseId  String?
  bookingId String?

  createdAt DateTime @default(now())

  @@map("notifications")
}
